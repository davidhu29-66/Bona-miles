# Copy this file to .env for local development (npm run dev).
# For the deployed site, add these same values in:
# Vercel → your project → Settings → Environment Variables
#
# Get all of these from: Firebase Console → Project Settings → General →
# "Your apps" → the web app you registered (</> icon).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
