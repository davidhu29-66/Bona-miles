rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user has exactly one document, keyed by their own uid,
    // holding their trips/locations. No one can read or write another
    // user's document.
    match /mileageApp/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
